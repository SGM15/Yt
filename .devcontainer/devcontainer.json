{
  "name": "TrackUp",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy"
      ]
    }
  },
  "portsAttributes": {
    "8000": {
      "label": "TrackUp API",
      "onAutoForward": "openBrowser"
    }
  }
}
